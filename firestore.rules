rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Admin membership is provisioned by a trusted project owner.
    // Client applications must never be allowed to create or edit /admins documents.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /profiles/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'slug', 'description', 'category', 'price',
          'currency', 'images', 'variants', 'stock', 'active',
          'featured', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.slug is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.currency == 'GHS'
        && request.resource.data.active is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'slug', 'description', 'category', 'price',
          'currency', 'images', 'variants', 'stock', 'active',
          'featured', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.currency == 'GHS'
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // These are enquiries/requested baskets, NOT confirmed paid orders.
    // No payment or final price fields are accepted from the client.
    match /orderRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'customerUid', 'requestedItems', 'customerNote',
          'contactPreference', 'status', 'createdAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.requestedItems is list
        && request.resource.data.requestedItems.size() > 0
        && request.resource.data.requestedItems.size() <= 10
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn()
        && (resource.data.customerUid == request.auth.uid || isAdmin());

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Confirmed orders are written only by trusted server-side code or an admin.
      allow read: if signedIn()
        && (resource.data.customerUid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }
  }
}
